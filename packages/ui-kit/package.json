{
  "name": "@wikialisa/ui-kit",
  "version": "1.0.1",
  "description": "WIKIALISA Design System — React component library, design tokens, icons and brand assets for all AXQ apps",
  "author": "AXQ Tech Holding JSC <dev@axvn.vn>",
  "license": "BSL-1.1",
  "homepage": "https://github.com/wikialisa/wikialisa#readme",
  "sideEffects": false,
  "keywords": [
    "wikialisa",
    "axvn",
    "axq",
    "react",
    "ui",
    "design-system",
    "components",
    "fintech",
    "mobile",
    "pwa",
    "tailwind",
    "tokens",
    "icons",
    "vietnam",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^3.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wikialisa/wikialisa.git",
    "directory": "packages/ui-kit"
  },
  "bugs": {
    "url": "https://github.com/wikialisa/wikialisa/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
