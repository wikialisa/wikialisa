{
  "name": "@wikialisa/mongo-db",
  "version": "1.0.0",
  "description": "Shared Mongoose connection and typed schemas for on-chain event storage — indexer-subgraph",
  "author": "AXQ Tech Holding JSC <dev@axvn.vn>",
  "license": "BSL-1.1",
  "private": true,
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "mongoose": "^8.9.0",
    "@wikialisa/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
