{
  "name": "@wikialisa/sdk-swift",
  "version": "1.0.2",
  "description": "SWIFT Alliance Gateway SDK — OAuth2, GPI Tracker, PKI, EVM bridge for @wikialisa institutional banking",
  "author": "AXQ Tech Holding JSC <dev@axvn.vn>",
  "license": "BSL-1.1",
  "homepage": "https://github.com/wikialisa/wikialisa#readme",
  "sideEffects": false,
  "keywords": [
    "wikialisa",
    "axvn",
    "swift",
    "oauth2",
    "gpi",
    "pki",
    "evm",
    "fintech",
    "banking",
    "institutional",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "ethers": "^6.0.0",
    "fast-xml-parser": "^4.0.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@wikialisa/config":     "workspace:*",
    "@wikialisa/swift-core": "workspace:*",
    "@wikialisa/types":      "workspace:*"
  },
  "peerDependenciesMeta": {
    "@wikialisa/config":     { "optional": true },
    "@wikialisa/swift-core": { "optional": true },
    "@wikialisa/types":      { "optional": true }
  },
  "devDependencies": {
    "@wikialisa/config":     "workspace:*",
    "@wikialisa/swift-core": "workspace:*",
    "@wikialisa/types":      "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wikialisa/wikialisa.git",
    "directory": "packages/sdk-swift"
  },
  "bugs": {
    "url": "https://github.com/wikialisa/wikialisa/issues"
  }
}