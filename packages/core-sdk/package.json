{
  "name": "@wikialisa/core-sdk",
  "version": "1.0.1",
  "description": "WIKIALISA Core SDK — Solana/EVM Web3 wrapper, Anchor IDL integrator and wallet utilities for all AXQ apps",
  "author": "AXQ Tech Holding JSC <dev@axvn.vn>",
  "license": "BSL-1.1",
  "homepage": "https://github.com/wikialisa/wikialisa#readme",
  "sideEffects": false,
  "keywords": [
    "wikialisa",
    "axvn",
    "axq",
    "sdk",
    "solana",
    "evm",
    "web3",
    "anchor",
    "wallet",
    "blockchain",
    "fintech",
    "typescript",
    "vietnam"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wikialisa/config": "workspace:*",
    "@wikialisa/types": "workspace:*",
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/web3.js": "^1.95.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wikialisa/wikialisa.git",
    "directory": "packages/core-sdk"
  },
  "bugs": {
    "url": "https://github.com/wikialisa/wikialisa/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
