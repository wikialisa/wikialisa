{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    ".env.*",
    "tsconfig.json",
    "tsconfig.base.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "MONGODB_URI",
    "MONGODB_DBNAME",
    "SOLANA_RPC",
    "ENABLE_SOLANA_WATCHER",
    "VERCEL_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "NEXT_PUBLIC_RPC_URL",
    "NEXT_PUBLIC_RPC_URL_SOLANA",
    "NEXT_PUBLIC_CHAIN_ID",
    "NEXT_PUBLIC_CONTRACT_KERNEL",
    "NEXT_PUBLIC_CONTRACT_AXQ_TOKEN",
    "NEXT_PUBLIC_CONTRACT_TREASURY",
    "NEXT_PUBLIC_CONTRACT_RANGE",
    "DID_REGISTRY_ADDRESS",
    "VND_GATEWAY_ADDRESS",
    "SWIFT_BRIDGE_ADDRESS",
    "SWIFT_BIC",
    "SWIFT_HOST",
    "SWIFT_LAU_KEY",
    "SWIFT_RBAC_TOKEN",
    "JWT_SECRET",
    "ENCRYPTION_KEY",
    "KYC_PROVIDER_URL",
    "KYC_API_KEY",
    "DUNE_API_KEY",
    "TELEGRAM_BOT_TOKEN",
    "DISCORD_WEBHOOK_URL",
    "HARDHAT_NETWORK",
    "PRIVATE_KEY_DEPLOYER",
    "SENTRY_DSN",
    "LOG_LEVEL",
    "AUTH_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "contracts/**/*.sol",
        "tsconfig.json",
        "tsconfig.build.json",
        "package.json"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "out/**",
        "target/deploy/**"
      ],
      "env": [
        "NODE_ENV"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "test/**",
        "vitest.config.*",
        "jest.config.*",
        "package.json"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "NODE_ENV",
        "CI"
      ]
    },
    "lint": {
      "inputs": [
        "src/**",
        ".eslintrc*",
        "eslint.config.*",
        "package.json"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.build.json",
        "package.json"
      ],
      "outputs": [
        "tsconfig.tsbuildinfo"
      ]
    },
    "clean": {
      "cache": false,
      "inputs": []
    },
    "format": {
      "inputs": [
        "src/**/*.{ts,tsx}",
        ".prettierrc*",
        "prettier.config.*"
      ],
      "outputs": []
    },
    "format:check": {
      "inputs": [
        "src/**/*.{ts,tsx}",
        ".prettierrc*",
        "prettier.config.*"
      ],
      "outputs": []
    },
    "publish-packages": {
      "dependsOn": [
        "^build",
        "^test"
      ],
      "cache": false
    },
    "@wikialisa/types#build": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/config#build": {
      "dependsOn": [
        "@wikialisa/types#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/web3-config#build": {
      "dependsOn": [
        "@wikialisa/config#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/ui-kit#build": {
      "dependsOn": [
        "@wikialisa/types#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "vite.config.*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/swift-core#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/swift-adapter#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/sdk-swift#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build",
        "@wikialisa/swift-core#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/core-sdk#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/db#build": {
      "dependsOn": [
        "@wikialisa/types#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/contracts#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build"
      ],
      "inputs": [
        "src/**",
        "contracts/**/*.sol",
        "tsconfig.json",
        "hardhat.config.*",
        "foundry.toml",
        "package.json"
      ],
      "outputs": [
        "dist/**",
        "artifacts/**",
        "typechain-types/**"
      ]
    },
    "@wikialisa/merchant-sdk#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/api-gateway#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build",
        "@wikialisa/db#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.build.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/fiat-connector-api#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build",
        "@wikialisa/db#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/otc-liquidity-engine#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build",
        "@wikialisa/db#build",
        "@wikialisa/core-sdk#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/mongo-db#build": {
      "dependsOn": [
        "@wikialisa/types#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/indexer-subgraph#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build",
        "@wikialisa/mongo-db#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/svc-swift-gateway#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build",
        "@wikialisa/swift-core#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/swift-chain-bridge#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build",
        "@wikialisa/swift-core#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/dune-alert-bots#build": {
      "dependsOn": [
        "@wikialisa/types#build",
        "@wikialisa/config#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@wikialisa/role-engine#build": {
      "dependsOn": [],
      "inputs": [
        "role-engine.js",
        "package.json"
      ],
      "outputs": []
    },
    "@wikialisa/mock-mgw-daemon#build": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
