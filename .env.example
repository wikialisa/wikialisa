# ─────────────────────────────────────────────────────────────────────────────
# Wikialisa — Environment Variables Example
# Copy this file to .env and fill in the real values.
# Never commit the .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Auth Mode ────────────────────────────────────────────────────────────────
# test     = Không cần OTP thực, OTP="000000", màn hình OTP → Thiết lập PIN
# onchain  = Flow thực: OTP gửi qua SMS, KYC đầy đủ (default production)
AUTH_MODE=test

# ── API Gateway ───────────────────────────────────────────────────────────────
PORT=5000
WEBSOCKET_PORT=5001
API_PREFIX=/api/v1

# Allowed CORS origin (front-end URL)
APP_URL=http://localhost:3010

# ── Database — PostgreSQL ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/wikialisa

# ── Database — MongoDB (on-chain event store for indexer-subgraph) ────────────
MONGODB_URI=mongodb://axvn_admin:dev_mongo_2026@localhost:27017/wikialisa_indexer?authSource=admin
MONGODB_DBNAME=wikialisa_indexer
MONGO_ROOT_USER=axvn_admin
MONGO_ROOT_PASS=dev_mongo_2026
MONGO_APP_PASS=CHANGE_ME_indexer_app_2026

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# OTP TTL in seconds (default: 300)
REDIS_OTP_TTL=300

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRE=15m
REFRESH_TOKEN_SECRET=change_refresh_me
REFRESH_TOKEN_EXPIRE=7d

# ── Blockchain / Chain ────────────────────────────────────────────────────────
CHAIN_ID=1
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_WSS_RPC_URL=wss://api.mainnet-beta.solana.com

# ── Indexer-subgraph ──────────────────────────────────────────────────────────
APPCHAIN_RPC=https://rpc.axvn.vn
# Enable Solana WebSocket watcher (set to true when SOLANA_RPC is available)
SOLANA_RPC=https://api.mainnet-beta.solana.com
ENABLE_SOLANA_WATCHER=false

# ── Front-end Public Vars ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ── Webhooks / Compliance ─────────────────────────────────────────────────────
COMPLIANCE_SECRET_KEY=webhook_secret_placeholder

# ── SWIFT Integration ─────────────────────────────────────────────────────────
SWIFT_CLIENT_ID=your_swift_client_id
SWIFT_CLIENT_SECRET=your_swift_client_secret
SWIFT_OAUTH_TOKEN_URL=https://sandbox.swift.com/oauth2/v1/token
SWIFT_OAUTH_SCOPE=swift.preval!p swift.apitracker!p
SWIFT_ENCRYPTION_KEY=your_32_byte_hex_encryption_key
LAU_KEY_HEX=your_lau_key_hex
LAU_SECRET=your_lau_secret

# ── Dune Analytics ────────────────────────────────────────────────────────────
DUNE_API_KEY=your_dune_api_key
DUNE_RESERVE_QUERY_ID=123456

# ── Telegram Alert Bot ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALERT_CHAT_ID=your_telegram_chat_id

# ── Misc Services ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
TRIGGER_INTERVAL_MS=30000
WS_PING_INTERVAL_MS=30000
WS_PONG_TIMEOUT_MS=10000
