# ─── Dockerfile.pay-portal ───────────────────────────────────────────────────
# Next.js standalone — apps/pay-portal — Port 3002
ARG NODE_VERSION=22
ARG PNPM_VERSION=9.15.9

FROM node:${NODE_VERSION}-alpine AS base
RUN apk add --no-cache libc6-compat && \
    corepack enable && \
    corepack prepare pnpm@${PNPM_VERSION} --activate

FROM base AS builder
WORKDIR /app

COPY pnpm-workspace.yaml turbo.json package.json pnpm-lock.yaml ./
COPY packages/ ./packages/
COPY apps/pay-portal/ ./apps/pay-portal/

RUN pnpm install --frozen-lockfile
ARG NEXT_TELEMETRY_DISABLED=1
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm turbo build --filter=pay-portal...

FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3002
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/pay-portal/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/pay-portal/.next/static      ./apps/pay-portal/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/pay-portal/public            ./apps/pay-portal/public

USER nextjs
EXPOSE 3002
CMD ["node", "apps/pay-portal/server.js"]
