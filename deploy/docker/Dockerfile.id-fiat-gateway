# ─── Dockerfile.id-fiat-gateway ─────────────────────────────────────────────
# Next.js standalone — apps/id-fiat-gateway — Port 3001
ARG NODE_VERSION=22
ARG PNPM_VERSION=9.15.9

FROM node:${NODE_VERSION}-alpine AS base
RUN apk add --no-cache libc6-compat && \
    corepack enable && \
    corepack prepare pnpm@${PNPM_VERSION} --activate

FROM base AS builder
WORKDIR /app

COPY pnpm-workspace.yaml turbo.json package.json pnpm-lock.yaml ./
COPY packages/ ./packages/
COPY apps/id-fiat-gateway/ ./apps/id-fiat-gateway/

RUN pnpm install --frozen-lockfile
ARG NEXT_TELEMETRY_DISABLED=1
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm turbo build --filter=id-fiat-gateway...

FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/id-fiat-gateway/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/id-fiat-gateway/.next/static      ./apps/id-fiat-gateway/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/id-fiat-gateway/public            ./apps/id-fiat-gateway/public

USER nextjs
EXPOSE 3001
CMD ["node", "apps/id-fiat-gateway/server.js"]
