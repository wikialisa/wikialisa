# ─── Dockerfile: dune-alert-bots ─────────────────────────────────────────────
# Service: @wikialisa/dune-alert-bots
# No exposed port — runs as a scheduled worker process
# Stages: base → builder → dev | runner
# ─────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS base
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.base.json ./

# ── Builder ────────────────────────────────────────────────────────────────────
FROM base AS builder
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

COPY packages/types  ./packages/types
COPY packages/config ./packages/config

COPY services/dune-alert-bots ./services/dune-alert-bots

RUN pnpm install --frozen-lockfile --prefer-offline

RUN pnpm --filter @wikialisa/types          build
RUN pnpm --filter @wikialisa/config         build
RUN pnpm --filter @wikialisa/dune-alert-bots build

# ── Dev stage ─────────────────────────────────────────────────────────────────
FROM builder AS dev
ENV NODE_ENV=development
CMD ["pnpm", "--filter", "@wikialisa/dune-alert-bots", "dev"]

# ── Runner ────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY --from=builder /app/services/dune-alert-bots/dist         ./services/dune-alert-bots/dist
COPY --from=builder /app/services/dune-alert-bots/package.json ./services/dune-alert-bots/package.json
COPY --from=builder /app/packages/types/dist       ./packages/types/dist
COPY --from=builder /app/packages/types/package.json ./packages/types/package.json
COPY --from=builder /app/packages/config/dist      ./packages/config/dist
COPY --from=builder /app/packages/config/package.json ./packages/config/package.json
COPY --from=builder /app/node_modules              ./node_modules
COPY --from=builder /app/package.json              ./package.json
COPY --from=builder /app/pnpm-workspace.yaml       ./pnpm-workspace.yaml

# No EXPOSE — worker process, no inbound connections
CMD ["node", "services/dune-alert-bots/dist/index.js"]
