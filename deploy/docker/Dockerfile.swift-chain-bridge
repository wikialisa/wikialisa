# ─── Dockerfile: swift-chain-bridge ──────────────────────────────────────────
# Service: @wikialisa/swift-chain-bridge
# Port: 4005 — Bi-Directional SWIFT ↔ Blockchain Oracle Relayer
#   INBOUND:  swift-gateway webhook → settleInboundSwift() → Mint AXQ
#   OUTBOUND: SwiftOutboundRequested EVM event → swift-gateway /send-mt103
# Stages: base → builder → dev | runner
# ─────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS base
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.base.json ./

# ── Builder ────────────────────────────────────────────────────────────────────
FROM base AS builder
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

COPY packages/types      ./packages/types
COPY packages/config     ./packages/config
COPY packages/swift-core ./packages/swift-core

COPY services/swift-chain-bridge ./services/swift-chain-bridge

RUN pnpm install --frozen-lockfile --prefer-offline

RUN pnpm --filter @wikialisa/types             build
RUN pnpm --filter @wikialisa/config            build
RUN pnpm --filter @wikialisa/swift-core        build
RUN pnpm --filter @wikialisa/swift-chain-bridge build

# ── Dev stage ─────────────────────────────────────────────────────────────────
FROM builder AS dev
ENV NODE_ENV=development
EXPOSE 4005
CMD ["pnpm", "--filter", "@wikialisa/swift-chain-bridge", "dev"]

# ── Runner ────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY --from=builder /app/services/swift-chain-bridge/dist         ./services/swift-chain-bridge/dist
COPY --from=builder /app/services/swift-chain-bridge/package.json ./services/swift-chain-bridge/package.json
COPY --from=builder /app/packages/types/dist        ./packages/types/dist
COPY --from=builder /app/packages/types/package.json ./packages/types/package.json
COPY --from=builder /app/packages/config/dist       ./packages/config/dist
COPY --from=builder /app/packages/config/package.json ./packages/config/package.json
COPY --from=builder /app/packages/swift-core/dist   ./packages/swift-core/dist
COPY --from=builder /app/packages/swift-core/package.json ./packages/swift-core/package.json
COPY --from=builder /app/node_modules               ./node_modules
COPY --from=builder /app/package.json               ./package.json
COPY --from=builder /app/pnpm-workspace.yaml        ./pnpm-workspace.yaml

EXPOSE 4005
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:4005/health || exit 1

CMD ["node", "services/swift-chain-bridge/dist/index.js"]
