# ─── Dockerfile: fiat-connector-api ─────────────────────────────────────────
# Service: @wikialisa/fiat-connector-api
# Port: 4001
# Stages: base → builder → dev | runner
# ─────────────────────────────────────────────────────────────────────────────

# ── Base: shared pnpm + workspace manifests ───────────────────────────────────
FROM node:22-alpine AS base
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# Workspace manifests + lock file for deterministic install
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json tsconfig.base.json ./

# ── Builder ────────────────────────────────────────────────────────────────────
FROM base AS builder
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

# Shared packages (only what this service needs)
COPY packages/types    ./packages/types
COPY packages/config   ./packages/config
COPY packages/db       ./packages/db

# Service source
COPY services/fiat-connector-api ./services/fiat-connector-api

RUN pnpm install --frozen-lockfile --prefer-offline

# Build dependency chain bottom-up
RUN pnpm --filter @wikialisa/types           build
RUN pnpm --filter @wikialisa/config          build
RUN pnpm --filter @wikialisa/db              build
RUN pnpm --filter @wikialisa/fiat-connector-api build

# ── Dev stage (hot-reload, mounted source) ────────────────────────────────────
FROM builder AS dev
ENV NODE_ENV=development
EXPOSE 4001
CMD ["pnpm", "--filter", "@wikialisa/fiat-connector-api", "dev"]

# ── Runner (minimal production image) ────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# Copy only built artefacts + production node_modules
COPY --from=builder /app/services/fiat-connector-api/dist         ./services/fiat-connector-api/dist
COPY --from=builder /app/services/fiat-connector-api/package.json ./services/fiat-connector-api/package.json
COPY --from=builder /app/packages/types/dist      ./packages/types/dist
COPY --from=builder /app/packages/types/package.json ./packages/types/package.json
COPY --from=builder /app/packages/config/dist     ./packages/config/dist
COPY --from=builder /app/packages/config/package.json ./packages/config/package.json
COPY --from=builder /app/packages/db/dist         ./packages/db/dist
COPY --from=builder /app/packages/db/package.json ./packages/db/package.json
COPY --from=builder /app/node_modules             ./node_modules
COPY --from=builder /app/package.json             ./package.json
COPY --from=builder /app/pnpm-workspace.yaml      ./pnpm-workspace.yaml

EXPOSE 4001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:4001/health || exit 1

CMD ["node", "services/fiat-connector-api/dist/index.js"]
