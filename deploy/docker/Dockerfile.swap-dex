# ─── Dockerfile.swap-dex ─────────────────────────────────────────────────────
# Next.js standalone — apps/swap-dex — Port 3004
ARG NODE_VERSION=22
ARG PNPM_VERSION=9.15.9

FROM node:${NODE_VERSION}-alpine AS base
RUN apk add --no-cache libc6-compat && \
    corepack enable && \
    corepack prepare pnpm@${PNPM_VERSION} --activate

FROM base AS builder
WORKDIR /app

COPY pnpm-workspace.yaml turbo.json package.json pnpm-lock.yaml ./
COPY packages/ ./packages/
COPY apps/swap-dex/ ./apps/swap-dex/

RUN pnpm install --frozen-lockfile
ARG NEXT_TELEMETRY_DISABLED=1
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm turbo build --filter=swap-dex...

FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3004
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/swap-dex/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/swap-dex/.next/static      ./apps/swap-dex/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/swap-dex/public            ./apps/swap-dex/public

USER nextjs
EXPOSE 3004
CMD ["node", "apps/swap-dex/server.js"]
