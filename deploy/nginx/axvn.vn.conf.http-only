# ═══════════════════════════════════════════════════════════════════════════════
#  AXQ — Nginx Reverse Proxy Config  [HTTP-ONLY / pre-SSL]
#  Domain  : axvn.vn  (alias của app.vnkr.vn — cùng upstream port 3010)
#  Upstream: localhost:3010 (Next.js 14 — app-web PWA)
#  Dùng file này TRƯỚC khi cấp cert Let's Encrypt.
#  Sau khi có cert, thay bằng axvn.vn.conf (HTTPS đầy đủ).
# ═══════════════════════════════════════════════════════════════════════════════

upstream axvn_web {
    server 127.0.0.1:3010;
    keepalive 64;
}

# ── HTTP — phục vụ ACME challenge + proxy tạm thời ─────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name axvn.vn www.axvn.vn;

    # ACME challenge (Let's Encrypt HTTP-01)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Proxy tất cả request → Next.js (chưa redirect HTTPS)
    location / {
        proxy_pass         http://axvn_web;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
    }

    access_log /var/log/nginx/axvn.vn.access.log;
    error_log  /var/log/nginx/axvn.vn.error.log warn;
}
