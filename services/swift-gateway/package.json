{
  "name": "@wikialisa/svc-swift-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "[otc.axvn.vn] SWIFT Messaging Gateway Service — interbank MT103/MT202/pacs.008 relay via SWIFT Microgateway 2.0.17",
  "main": "./dist/index.js",
  "scripts": {
    "build":     "tsup src/index.ts --format cjs --dts --clean",
    "dev":       "ts-node-dev --respawn --transpile-only src/index.ts",
    "start":     "node dist/index.js",
    "lint":      "eslint src",
    "typecheck": "tsc --noEmit",
    "test":      "vitest run",
    "clean":     "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@wikialisa/config":     "workspace:*",
    "@wikialisa/swift-core": "workspace:*",
    "@wikialisa/types":      "workspace:*",
    "axios":    "^1.7.9",
    "fastify":  "^5.2.1",
    "ioredis":  "^5.4.1",
    "zod":      "^3.24.1"
  },
  "devDependencies": {
    "@types/node":  "^22.10.0",
    "ts-node":      "^10.9.2",
    "ts-node-dev":  "^2.0.0",
    "tsup":         "^8.3.5",
    "typescript":   "^5.7.2",
    "vitest":       "^2.1.8"
  }
}
