# ── pnpm Registry Configuration ───────────────────────────────────────────────
# Public packages → npmjs.com (default)
registry=https://registry.npmjs.org

# @wikialisa/* packages: public packages dùng npmjs, private dùng GitHub Packages
# Khi GITHUB_TOKEN chưa có (dev local) → bỏ qua dòng auth bên dưới
# Khi CI/CD có GITHUB_TOKEN → uncomment hoặc set qua env
@wikialisa:registry=https://registry.npmjs.org

# GitHub Packages auth — chỉ cần khi publish hoặc install private packages
# Uncomment và set GITHUB_TOKEN khi cần:
# @wikialisa:registry=https://npm.pkg.github.com
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Peer dependency rules
strict-peer-dependencies=false
auto-install-peers=true

# WSL1 / Windows filesystem compatibility
# node-linker=hoisted: copy trực tiếp, không dùng symlink (tránh EACCES rename)
# package-import-method=copy: dùng copy thay vì hardlink/rename
node-linker=hoisted
hoist=true
shamefully-hoist=true
package-import-method=copy
# WSL1: tắt atomic rename và postinstall scripts (esbuild, swc... rename node_modules)
side-effects-cache=false
verify-store-integrity=false
ignore-scripts=true
# Không tạo node_modules trong từng workspace package — chỉ root
hoist-workspace-packages=true
